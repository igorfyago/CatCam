<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="20dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextureView
        android:id="@+id/preview"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginBottom="8dp" />

    <!-- Mic level: one moving bar = sound is flowing. No numbers on purpose. -->
    <ProgressBar
        android:id="@+id/audio_level"
        style="?android:attr/progressBarStyleHorizontal"
        android:max="100"
        android:progress="0"
        android:layout_marginBottom="8dp"
        android:layout_width="match_parent"
        android:layout_height="6dp" />

    <TextView
        android:id="@+id/status"
        android:text="Idle"
        android:textSize="16sp"
        android:gravity="center"
        android:layout_marginBottom="16dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <!-- Zoom row sits ABOVE the Start/Stop/Flip row on purpose: that row must
         stay the last child (flush to the bottom) or camctl.bat's measured
         tap coordinates go stale and the tray taps thin air. -->
    <LinearLayout
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="8dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

        <Button
            android:id="@+id/zoom_out"
            android:text="−"
            android:layout_marginEnd="8dp"
            android:layout_width="72dp"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/zoom_label"
            android:text="1.0×"
            android:textSize="18sp"
            android:gravity="center"
            android:layout_width="72dp"
            android:layout_height="wrap_content" />

        <Button
            android:id="@+id/zoom_in"
            android:text="+"
            android:layout_marginStart="8dp"
            android:layout_width="72dp"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <LinearLayout
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="8dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

        <Button
            android:id="@+id/tone_cool"
            android:text="Cool"
            android:layout_marginEnd="8dp"
            android:layout_width="88dp"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/tone_label"
            android:text="0"
            android:textSize="18sp"
            android:gravity="center"
            android:layout_width="48dp"
            android:layout_height="wrap_content" />

        <Button
            android:id="@+id/tone_warm"
            android:text="Warm"
            android:layout_marginStart="8dp"
            android:layout_width="88dp"
            android:layout_height="wrap_content" />

        <Button
            android:id="@+id/day_night"
            android:text="Night"
            android:layout_marginStart="24dp"
            android:layout_width="96dp"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <LinearLayout
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

        <Button
            android:id="@+id/start"
            android:text="Start"
            android:layout_marginEnd="8dp"
            android:layout_width="120dp"
            android:layout_height="wrap_content" />

        <Button
            android:id="@+id/stop"
            android:text="Stop"
            android:enabled="false"
            android:layout_marginEnd="8dp"
            android:layout_width="120dp"
            android:layout_height="wrap_content" />

        <Button
            android:id="@+id/flip"
            android:text="Front"
            android:layout_width="120dp"
            android:layout_height="wrap_content" />
    </LinearLayout>
</LinearLayout>
