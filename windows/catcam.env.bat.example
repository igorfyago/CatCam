@echo off
REM Machine-local TabletCam settings. Copy to catcam.env.bat (git-ignored)
REM or let installer\install.ps1 generate it. Everything here is OPTIONAL:
REM without this file the scripts use the defaults shown.

REM Where adb.exe lives:
REM set CATCAM_ADB=%USERPROFILE%\android-sdk\platform-tools\adb.exe

REM Pin a specific device serial (from: adb devices). Leave unset with one
REM USB device attached; the scripts then use -d (any USB device), which
REM also survives the same tablet appearing again over adb-WiFi.
REM set CATCAM_SERIAL=
